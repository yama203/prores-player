<Window x:Class="ProResPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProResPlayer"
        Title="ProRes Player" Icon="app.ico" ThemeMode="Dark" Width="1280" Height="800" MinWidth="760" MinHeight="420"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnKeyDown"
        Loaded="OnLoaded" Closed="OnClosed">
  <DockPanel>
    <!-- Menu, with short-lived messages (saved, copied, last file...) at its right end so the bottom bar never changes height. -->
    <Grid x:Name="TopBar" DockPanel.Dock="Top" Background="{StaticResource Panel}">
    <Menu x:Name="MainMenu" Background="Transparent">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="開く..." InputGestureText="Ctrl+O" Click="OnOpen"/>
        <MenuItem Header="比較用に開く (B)..." InputGestureText="Ctrl+Shift+O" Click="OnOpenB"/>
        <Separator/>
        <MenuItem Header="フレームを PNG で保存..." InputGestureText="Ctrl+S" Click="OnSaveFrame"/>
        <MenuItem Header="フレームをコピー" InputGestureText="Ctrl+C" Click="OnCopyFrame"/>
        <Separator/>
        <MenuItem Header="IN〜OUT をカットして保存..." InputGestureText="Ctrl+X" Click="OnCut"/>
        <Separator/>
        <MenuItem x:Name="AssocItem" Header="「プログラムから開く」に登録" Click="OnToggleAssociation"/>
        <Separator/>
        <MenuItem Header="終了" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="表示(_V)">
        <MenuItem Header="背景: 市松模様" InputGestureText="1" Tag="checker" Click="OnBackgroundMenu"/>
        <MenuItem Header="背景: 黒" InputGestureText="2" Tag="black" Click="OnBackgroundMenu"/>
        <MenuItem Header="背景: 白" InputGestureText="3" Tag="white" Click="OnBackgroundMenu"/>
        <MenuItem Header="アルファのみ" InputGestureText="4" Tag="alpha" Click="OnBackgroundMenu"/>
        <Separator/>
        <MenuItem x:Name="InfoItem" Header="情報パネル" InputGestureText="Tab" IsCheckable="True" IsChecked="True" Click="OnToggleInfo"/>
        <MenuItem Header="全画面" InputGestureText="F / ダブルクリック" Click="OnToggleFullscreen"/>
      </MenuItem>
      <MenuItem Header="比較(_C)">
        <MenuItem Header="オフ" Tag="off" Click="OnCompareMenu"/>
        <MenuItem Header="左右に並べる" Tag="side" Click="OnCompareMenu"/>
        <MenuItem Header="ワイプ" Tag="wipe" Click="OnCompareMenu"/>
      </MenuItem>
      <MenuItem Header="ヘルプ(_H)">
        <MenuItem Header="ショートカット一覧" Click="OnShortcuts"/>
      </MenuItem>
    </Menu>
    <TextBlock x:Name="StatusText" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"
               Margin="0,0,16,0" Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
    </Grid>

    <!-- Transport / controls -->
    <Border x:Name="ControlBar" DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="10,6,10,8">
      <StackPanel>
        <!-- Seek bar with the IN / OUT range: a band over the track, [ ] marks at the ends and their timecodes
             in the row underneath (kept even without a range so the bar never changes height). -->
        <Grid Margin="0,0,0,2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
          </Grid.RowDefinitions>
          <!-- Drawn behind the slider so the track and thumb stay crisp on top of the band. -->
          <Canvas x:Name="RangeCanvas" Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle x:Name="RangeBand" Height="12" RadiusX="3" RadiusY="3" Fill="{StaticResource Accent}" Opacity="0.3" Visibility="Collapsed"/>
            <Path x:Name="InMark" Data="M 7,0 L 0,0 L 0,22 L 7,22" Stroke="{StaticResource Accent}" StrokeThickness="2.5"
                  StrokeLineJoin="Round" Visibility="Collapsed"/>
            <Path x:Name="OutMark" Data="M 0,0 L 7,0 L 7,22 L 0,22" Stroke="{StaticResource Accent}" StrokeThickness="2.5"
                  StrokeLineJoin="Round" Visibility="Collapsed"/>
            <TextBlock x:Name="InLabel" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
            <TextBlock x:Name="OutLabel" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
          </Canvas>
          <!-- Mouse down is hooked in code (handledEventsToo) because Slider's class handler marks it handled. -->
          <Slider x:Name="SeekBar" Minimum="0" Maximum="1" Focusable="False"
                  ValueChanged="OnSeekBarChanged" SizeChanged="OnSeekBarSizeChanged"
                  PreviewMouseMove="OnSeekBarMove" PreviewMouseLeftButtonUp="OnSeekBarUp"/>
        </Grid>

        <!-- One row: transport, files | loop, cut (centred) | view, export, info.
             When the window is narrow, ArrangeControls hides the text labels (icons only). -->
        <DockPanel x:Name="ControlRow" SizeChanged="OnControlRowSizeChanged">
          <StackPanel x:Name="TransportGroup" DockPanel.Dock="Left" Orientation="Horizontal">
            <Button FontFamily="{StaticResource IconFont}" FontSize="15" MinWidth="34" Padding="7,3" Content="&#xE892;" ToolTip="先頭 (Home)" AutomationProperties.Name="先頭" Click="OnGoStart"/>
            <Button FontFamily="{StaticResource IconFont}" FontSize="15" MinWidth="34" Padding="7,3" Content="&#xE76B;" ToolTip="1フレーム戻る (←)" AutomationProperties.Name="1フレーム戻る" Click="OnStepBack"/>
            <Button x:Name="PlayButton" AutomationProperties.Name="再生 / 一時停止" FontFamily="{StaticResource IconFont}" Padding="7,3" Content="&#xE768;" MinWidth="44" FontSize="17"
                    ToolTip="再生 / 一時停止 (Space)" Click="OnPlayPause"/>
            <Button FontFamily="{StaticResource IconFont}" FontSize="15" MinWidth="34" Padding="7,3" Content="&#xE76C;" ToolTip="1フレーム進む (→)" AutomationProperties.Name="1フレーム進む" Click="OnStepForward"/>
            <Button FontFamily="{StaticResource IconFont}" FontSize="15" MinWidth="34" Padding="7,3" Content="&#xE893;" ToolTip="末尾 (End)" AutomationProperties.Name="末尾" Click="OnGoEnd"/>
            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="124">
              <TextBlock x:Name="TimecodeText" Text="00:00:00:00" FontFamily="Consolas" FontSize="18" LineHeight="20"/>
              <TextBlock x:Name="FrameText" Text="0 / 0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Dim}"/>
            </StackPanel>
          </StackPanel>

          <!-- Previous / next movie in the same folder -->
          <StackPanel x:Name="FileGroup" DockPanel.Dock="Left" Orientation="Horizontal">
            <Rectangle Style="{StaticResource Divider}"/>
            <Button x:Name="PrevFileButton" AutomationProperties.Name="前の動画" FontFamily="{StaticResource IconFont}" FontSize="15" MinWidth="34" Padding="7,3" Content="&#xE973;" Click="OnPrevFile" IsEnabled="False"
                    ToolTip="同じフォルダの前の動画 (Ctrl+← / PageUp)"/>
            <TextBlock x:Name="FilePosText" Text="" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Dim}"
                       VerticalAlignment="Center" MinWidth="44" TextAlignment="Center" ToolTip="同じフォルダの中で何本目か"/>
            <Button x:Name="NextFileButton" AutomationProperties.Name="次の動画" FontFamily="{StaticResource IconFont}" FontSize="15" MinWidth="34" Padding="7,3" Content="&#xE974;" Click="OnNextFile" IsEnabled="False"
                    ToolTip="同じフォルダの次の動画 (Ctrl+→ / PageDown)"/>
          </StackPanel>

          <StackPanel x:Name="RightGroup" DockPanel.Dock="Right" Orientation="Horizontal">
            <Slider x:Name="WipeSlider" Width="110" Minimum="0" Maximum="1" Value="0.5" Focusable="False" Margin="0,0,6,0"
                    VerticalAlignment="Center" Visibility="Collapsed" ValueChanged="OnWipeChanged" ToolTip="ワイプ位置 ([ / ])"/>
            <!-- Background and compare live in one drop-down menu. -->
            <Button x:Name="ViewButton" AutomationProperties.Name="表示" Click="OnViewButton" ToolTip="背景（アルファの確認）と比較の切り替え">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE890;"/>
                <TextBlock x:Name="ViewLabel" Text="表示" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" FontSize="10" Margin="6,1,0,0"/>
              </StackPanel>
              <Button.ContextMenu>
                <ContextMenu x:Name="ViewMenu">
                  <MenuItem Header="背景: 市松模様" InputGestureText="1" Tag="bg:checker" Click="OnViewMenuItem"/>
                  <MenuItem Header="背景: 黒" InputGestureText="2" Tag="bg:black" Click="OnViewMenuItem"/>
                  <MenuItem Header="背景: 白" InputGestureText="3" Tag="bg:white" Click="OnViewMenuItem"/>
                  <MenuItem Header="アルファのみ" InputGestureText="4" Tag="bg:alpha" Click="OnViewMenuItem"/>
                  <Separator/>
                  <MenuItem Header="比較: オフ" Tag="cmp:off" Click="OnViewMenuItem"/>
                  <MenuItem Header="比較: 左右に並べる" Tag="cmp:side" Click="OnViewMenuItem"/>
                  <MenuItem Header="比較: ワイプ" Tag="cmp:wipe" Click="OnViewMenuItem"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Rectangle Style="{StaticResource Divider}"/>
            <Button FontFamily="{StaticResource IconFont}" FontSize="15" MinWidth="34" Padding="7,3" Content="&#xE722;" AutomationProperties.Name="PNG で保存" ToolTip="今のフレームを PNG で保存 (Ctrl+S)" Click="OnSaveFrame"/>
            <Button FontFamily="{StaticResource IconFont}" FontSize="15" MinWidth="34" Padding="7,3" Content="&#xE8C8;" AutomationProperties.Name="コピー" ToolTip="今のフレームをクリップボードにコピー (Ctrl+C)" Click="OnCopyFrame"/>
            <ToggleButton x:Name="InfoButton" AutomationProperties.Name="情報パネル" MinWidth="34" Padding="8,3" ToolTip="情報パネルを出す / 閉じる (Tab)" Click="OnInfoButton">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;"/>
            </ToggleButton>
          </StackPanel>

          <!-- Last child fills the middle, centred there. -->
          <StackPanel x:Name="CenterGroup" Orientation="Horizontal" HorizontalAlignment="Center">
            <ToggleButton x:Name="LoopCheck" AutomationProperties.Name="ループ" MinWidth="34" Padding="8,3" IsChecked="True" ToolTip="ループ再生 オン / オフ (L)" Click="OnLoopCheck">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;"/>
                <TextBlock x:Name="LoopLabel" Text="ループ" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="CutToggle" AutomationProperties.Name="カット" MinWidth="34" Padding="8,3" Checked="OnCutToggle" Unchecked="OnCutToggle"
                          ToolTip="範囲（IN / OUT）を決めてカット保存するパネルを出す / 閉じる (X)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;"/>
                <TextBlock x:Name="CutLabel" Text="カット" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </DockPanel>

        <!-- Range / cut panel above the cut button. A Popup is its own window, so it can sit over the video. -->
        <Popup x:Name="CutPopup" PlacementTarget="{Binding ElementName=ControlBar}" Placement="Custom"
               StaysOpen="True" AllowsTransparency="True">
          <Border Background="#2B2B2B" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="8,6">
            <StackPanel Orientation="Horizontal">
              <Button Content="IN" ToolTip="今のフレームを開始点に（ループ / カットの範囲） (I)" Click="OnSetIn"/>
              <Button Content="OUT" ToolTip="今のフレームを終了点に（ループ / カットの範囲） (O)" Click="OnSetOut"/>
              <Button Content="クリア" ToolTip="IN / OUT をクリア (P)" Click="OnClearLoop"/>
              <TextBlock x:Name="CutRangeText" Text="範囲なし" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Dim}"
                         VerticalAlignment="Center" Margin="10,0" MinWidth="250" TextAlignment="Center"/>
              <Button x:Name="CutSaveButton" Content="カットして保存..." ToolTip="IN〜OUT の範囲だけ残して保存（再エンコードなし） (Ctrl+X)" Click="OnCut"/>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
    </Border>

    <!-- Info panel -->
    <Border x:Name="InfoPanel" DockPanel.Dock="Right" Width="270" Background="{StaticResource Panel}" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel Margin="0,0,0,2">
            <Button DockPanel.Dock="Right" Content="✕" MinWidth="24" Height="22" Padding="0" Margin="0"
                    AutomationProperties.Name="情報パネルを閉じる"
                    Background="Transparent" BorderBrush="Transparent" ToolTip="情報パネルを閉じる (Tab)" Click="OnInfoButton"/>
            <TextBlock Text="A" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="InfoA" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,16" Text="ファイルをドロップするか Ctrl+O で開きます"/>
          <StackPanel x:Name="InfoBPanel" Visibility="Collapsed">
            <TextBlock Text="B" FontWeight="Bold" Foreground="#6BB3F0"/>
            <TextBlock x:Name="InfoB" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Video area. Hosted Win32 windows cannot be overlapped by WPF content, so the
         wipe divider is the gap between host A and host B. -->
    <Grid x:Name="VideoArea" Background="#6BB3F0" SizeChanged="OnVideoAreaSizeChanged" ClipToBounds="True">
      <local:VideoHost x:Name="HostA" HorizontalAlignment="Stretch"/>
      <local:VideoHost x:Name="HostB" HorizontalAlignment="Right" Visibility="Collapsed"/>
    </Grid>
  </DockPanel>
</Window>
