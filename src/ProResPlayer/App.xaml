<Application x:Class="ProResPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Panel" Color="#262626"/>
    <SolidColorBrush x:Key="Fg" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Dim" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Accent" Color="#E8A33D"/>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,0"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Background" Value="#333"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="#444"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Application.Resources>
</Application>
