<Application x:Class="ProResPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Panel" Color="#262626"/>
    <SolidColorBrush x:Key="Fg" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Dim" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Accent" Color="#E8A33D"/>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,0"/>
    </Style>
    <!-- Flat rounded buttons shared by Button and ToggleButton. -->
    <Style x:Key="FlatButtonBase" TargetType="ButtonBase">
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Background" Value="#333"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="#3C3C3C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#444"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
              </Trigger>
              <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#4A3618"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource FlatButtonBase}"/>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource FlatButtonBase}"/>

    <!-- Thin vertical divider between groups. -->
    <Style x:Key="Divider" TargetType="Rectangle">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Fill" Value="#3C3C3C"/>
      <Setter Property="Margin" Value="10,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Application.Resources>
</Application>
