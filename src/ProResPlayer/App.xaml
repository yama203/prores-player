<Application x:Class="ProResPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose"
             ThemeMode="Dark">
  <!-- Fluent (Windows 11) theme, always dark: a video viewer should not flash white around the picture. -->
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Panel" Color="#202020"/>
    <SolidColorBrush x:Key="Fg" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Dim" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Accent" Color="#E8A33D"/>
    <SolidColorBrush x:Key="Line" Color="#333333"/>

    <!-- Fluent accent (seek bar, toggled buttons, focus) in the icon's orange instead of the Windows accent colour. -->
    <!-- The theme reads these through DynamicResource {x:Static SystemColors.AccentColor*Key}, so app-level keys win. -->
    <Color x:Key="{x:Static SystemColors.AccentColorKey}">#E8A33D</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#EDB25A</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#E8A33D</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#F5CF94</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#C98A2C</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#A8721F</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#7F5614</Color>

    <!-- Fluent controls, made compact for the transport bar. -->
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Windows 11 icon font (falls back to the Windows 10 one). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Thin vertical divider between groups. -->
    <Style x:Key="Divider" TargetType="Rectangle">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Fill" Value="{StaticResource Line}"/>
      <Setter Property="Margin" Value="6,6"/>
    </Style>
  </Application.Resources>
</Application>
